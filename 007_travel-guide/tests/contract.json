{
  "product": "travel-guide",
  "behaviors": [
    {
      "id": "page-count",
      "selector": ".page",
      "expect": "Exactly 7 pages exist"
    },
    {
      "id": "page-visible",
      "selector": ".page.active",
      "expect": "Exactly one active page at a time"
    },
    {
      "id": "next-button",
      "selector": "#btn-next",
      "expect": "Next button exists and advances page"
    },
    {
      "id": "prev-button",
      "selector": "#btn-prev",
      "expect": "Prev button exists and goes back"
    },
    {
      "id": "progress",
      "selector": "#progress",
      "expect": "Progress indicator updates with page"
    },
    {
      "id": "checklist-persist",
      "selector": "#checklist",
      "expect": "Checklist toggles persist across reload"
    },
    {
      "id": "keyboard-nav",
      "selector": "body",
      "expect": "ArrowLeft/ArrowRight navigate pages"
    },
    {
      "id": "prompt-sync",
      "selector": "#prompt-text",
      "expect": "The editable prompt changes with the active booklet page"
    },
    {
      "id": "prompt-copy",
      "selector": "#copy-prompt",
      "expect": "Copy button provides visible completion feedback"
    },
    {
      "id": "packing-manager",
      "selector": "#packing-dialog",
      "expect": "A categorized packing library can be opened from the compact checklist"
    },
    {
      "id": "packing-custom",
      "selector": "#custom-item-input",
      "expect": "Users can add custom packing items"
    },
    {
      "id": "packing-reorder",
      "selector": "#packing-sortable",
      "expect": "Selected packing items can be dragged or moved to reorder"
    }
  ]
}
