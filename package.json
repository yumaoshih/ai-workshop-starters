{
  "name": "ai-workshop-friday",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node 005_bingo-generator/server.js",
    "bingo:dev": "node 005_bingo-generator/server.js",
    "bingo:test": "playwright test tests/starters.spec.js --config=playwright.config.js --grep bingo-generator",
    "test:contracts": "node contract-test.js 001_fasting-clock && node contract-test.js 002_water-tracker && node contract-test.js 003_food-wheel && node contract-test.js 005_bingo-generator",
    "test:starters": "playwright test tests/starters.spec.js --config=playwright.config.js",
    "test:pages": "playwright test tests/pages.spec.js --config=playwright.config.js",
    "verify:static": "python3 verify_static.py",
    "verify": "npm run verify:static && npm run test:contracts && npm run test:starters && npm run test:pages"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "ws": "^8.21.3"
  }
}
