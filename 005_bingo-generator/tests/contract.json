{
  "product": "bingo-generator",
  "behaviors": [
    {
      "id": "board-initial",
      "selector": "#bingo-board",
      "expect": "Container exists with 25 cells (5x5)"
    },
    {
      "id": "cell-count",
      "selector": "#bingo-board .cell",
      "expect": "Exactly 25 cells present"
    },
    {
      "id": "free-center",
      "selector": "#bingo-board .cell.free",
      "expect": "Free center cell exists and displays '免費'"
    },
    {
      "id": "regenerate",
      "selector": "#btn-regenerate",
      "expect": "Button exists; clicking reshuffles board items"
    },
    {
      "id": "editable-item",
      "selector": "#item-list input",
      "expect": "24 editable inputs present"
    },
    {
      "id": "print",
      "selector": "#btn-print",
      "expect": "Print button exists"
    },
    {
      "id": "role-switch",
      "selector": "#role-host[role='tab']",
      "expect": "Host and player entry points are available from the product navigation"
    },
    {
      "id": "host-room",
      "selector": "#btn-create-room",
      "expect": "Host can create a private room"
    },
    {
      "id": "host-approval",
      "selector": "#pending-player-list",
      "expect": "Host can review a friend's join request before allowing entry"
    },
    {
      "id": "player-ready",
      "selector": "#btn-player-ready",
      "expect": "Approved player can declare readiness"
    },
    {
      "id": "start-gate",
      "selector": "#btn-start-game[disabled]",
      "expect": "Game starts disabled until every approved player is connected and ready"
    }
  ]
}
