{
  "product": "kids-reward-board",
  "behaviors": [
    {
      "id": "child-config",
      "selector": "#child-name-input",
      "expect": "Input for child name exists"
    },
    {
      "id": "reward-list",
      "selector": "#reward-list",
      "expect": "List of rewards with cost and redeem button"
    },
    {
      "id": "add-points",
      "selector": "#btn-add-points",
      "expect": "Add points button exists"
    },
    {
      "id": "subtract-points",
      "selector": "#btn-subtract-points",
      "expect": "Subtract button exists"
    },
    {
      "id": "block-negative",
      "selector": "#btn-subtract-points",
      "expect": "Subtract is disabled at zero and balance never goes negative"
    },
    {
      "id": "block-unaffordable",
      "selector": ".redeem-btn",
      "expect": "Redeem disabled when points below cost"
    },
    {
      "id": "persistence",
      "selector": "#balance",
      "expect": "Name, balance, rewards, target, and theme persist across reload"
    },
    {
      "id": "theme-picker",
      "selector": "#btn-open-theme",
      "expect": "Theme picker opens and changes only the visual theme"
    },
    {
      "id": "three-themes",
      "selector": "[data-theme-option]",
      "expect": "Adventure, sticker, and shop themes are available"
    },
    {
      "id": "target-reward",
      "selector": "#goal-progress",
      "expect": "A reward can be selected as the next goal with visible progress"
    },
    {
      "id": "edit-rewards",
      "selector": "#btn-edit-rewards",
      "expect": "Rewards can be added, edited, and removed locally"
    },
    {
      "id": "reset",
      "selector": "#btn-reset",
      "expect": "Reset action exists"
    }
  ]
}
